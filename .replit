language="nodejs"
run="yarn start && pm2 save && pm2 logs"
entrypoint = "src/aurora.js"
hidden = [".config", "yarn.lock"]
modules = ["nodejs-20", "web", "bash"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Pokemon Bot"

[[workflows.workflow]]
name = "Start Bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd eve-bot && bash start.sh"
waitForPort = 3000

[[workflows.workflow]]
name = "Pokemon Bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd pokemon-bot && bash start.sh"
waitForPort = 3001

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3002

[[ports]]
localPort = 6666
externalPort = 3000

[userenv]

[userenv.shared]
NAME = "EvE"
PREFIX = "-"
MODS_GROUP = "120363236615391329@g.us"
OWNER = "919028230554"
ADMIN_PASSWORD = "0000"
PORT = "3000"
